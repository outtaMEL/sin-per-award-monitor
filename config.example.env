# 复制为 .env 后填写
ORIGIN=SIN
DESTINATION=PER
DATE_START=2026-06-28
DATE_END=2026-07-06

# Business Saver 里程上限（SIN-PER 标准 Saver 约 62,500）
MAX_BUSINESS_MILES=70000

# 轮询间隔（秒），建议 3600–7200，勿高频
POLL_INTERVAL_MIN=3600
POLL_INTERVAL_MAX=5400

# ── 微信通知（推荐 Server酱）────────────────────────────────
# Server酱：https://sct.ftqq.com 微信登录 → 复制 SendKey
SERVERCHAN_SENDKEY=

# PushPlus：https://www.pushplus.plus（需实名认证）
PUSHPLUS_TOKEN=

# 企业微信群机器人 Webhook（有企业微信才用）
WEWORK_WEBHOOK=

# ── 其他通知（可选）────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_TO=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Playwright 浏览器数据目录（保存 Cloudflare cookie）
BROWSER_DATA_DIR=.browser_data

# 有界面模式更容易过 Cloudflare；headless 可能被拦
HEADLESS=false
